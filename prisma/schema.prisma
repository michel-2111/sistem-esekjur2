generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Jurusan {
  id                         String                    @id @db.VarChar(10)
  nama                       String                    @db.VarChar(255)

  kajur_id                   Int?                      @unique
  sekjur_id                  Int?                      @unique

  // Relasi ke Model User
  kajur                      User?                     @relation("KajurJurusan", fields: [kajur_id], references: [id])
  sekjur                     User?                     @relation("SekjurJurusan", fields: [sekjur_id], references: [id])

  prodi                      Prodi[]
  users                      User[]
  ta_committees              TA_Committee[]
  ta_settings                TA_Settings?
  // Relasi baru: Daftar dokumen wajib per jurusan
  ta_document_requirements   TA_Document_Requirement[]
  ta_assessment_components   TA_Assessment_Component[] 
  laboratoriums              Laboratorium[]
}

model Prodi {
  id         String   @id @db.VarChar(20)
  nama       String   @db.VarChar(255)
  jurusan_id String   @db.VarChar(10)
  courses    Course[]
  jurusan    Jurusan  @relation(fields: [jurusan_id], references: [id])
  users      User[]
}

model User {
  id                 Int                  @id @default(autoincrement())
  nama               String               @db.VarChar(255)
  identifier         String               @unique @db.VarChar(50)
  password           String               @db.VarChar(255)
  telepon            String?              @db.VarChar(20)
  nomor_rekening     String?              @db.VarChar(50)
  prodi_id           String?              @db.VarChar(20)
  jurusan_id         String?              @db.VarChar(10)

  lab_dipimpin                Laboratorium? @relation("KepalaLab")
  jurusan_dipimpin            Jurusan?             @relation("KajurJurusan")
  jurusan_disekretarisi       Jurusan?             @relation("SekjurJurusan")
  application_courses         Application_Course[]
  course_pengampu             Course_Pengampu[]
  sent_documents              Document[]
  received_documents          Document_Recipient[]
  uploaded_templates          Document_Template[]
  leave_applications          Leave_Application[]
  sa_applications             SA_Application[]
  jurusan                     Jurusan?             @relation(fields: [jurusan_id], references: [id])
  prodi                       Prodi?               @relation(fields: [prodi_id], references: [id])
  roles                       User_Roles[]
  ta_applications             TA_Application[]
  ta_committees               TA_Committee[]
  ta_exams                    TA_Examiner[]
  pembimbing_mahasiswa        TA_Supervisor[] @relation("MahasiswaBimbingan")
  bimbingan_dosen             TA_Supervisor[] @relation("DosenPembimbing")
}

model Role {
  id        Int          @id @default(autoincrement())
  nama_role String       @unique @db.VarChar(50)
  users     User_Roles[]
}

model User_Roles {
  user_id Int
  role_id Int
  role    Role @relation(fields: [role_id], references: [id])
  user    User @relation(fields: [user_id], references: [id])

  @@id([user_id, role_id])
}

model Academic_Period {
  id                 String              @id @db.VarChar(20)
  nama               String              @db.VarChar(255)
  start_date         DateTime            @db.Date
  end_date           DateTime            @db.Date
  leave_applications Leave_Application[]
  sa_applications    SA_Application[]
}

model Course {
  id                 Int                  @id @default(autoincrement())
  kode               String               @unique @db.VarChar(20)
  nama               String               @db.VarChar(255)
  sks                Int
  semester           Int
  prodi_id           String               @db.VarChar(20)
  application_courses Application_Course[]
  prodi              Prodi                @relation(fields: [prodi_id], references: [id])
  pengampu           Course_Pengampu[]
}

model Course_Pengampu {
  course_id Int
  dosen_id  Int
  course    Course @relation(fields: [course_id], references: [id])
  dosen     User   @relation(fields: [dosen_id], references: [id])

  @@id([course_id, dosen_id])
}

model SA_Application {
  id                   Int                  @id @default(autoincrement())
  mahasiswa_id         Int
  period_id            String               @db.VarChar(20)
  status               String               @db.VarChar(50)
  tanggal_pengajuan    DateTime?            @db.Timestamp(6)
  tanggal_pembayaran   DateTime?            @db.Timestamp(6)
  bukti_pembayaran_url String?              @db.VarChar(255)
  alasan_ditolak       String?
  max_sks              Int?
  application_courses  Application_Course[]
  mahasiswa            User                 @relation(fields: [mahasiswa_id], references: [id])
  period               Academic_Period      @relation(fields: [period_id], references: [id])
}

model Application_Course {
  application_id Int
  course_id      Int
  dosen_id       Int?
  nilai          String?        @db.Char(2)
  jadwal         String?        @db.VarChar(255)
  ruang          String?        @db.VarChar(50)
  materi_url     String?        @db.VarChar(255)
  kelas_selesai  Boolean?       @default(false)
  application    SA_Application @relation(fields: [application_id], references: [id])
  course         Course         @relation(fields: [course_id], references: [id])
  dosen          User?          @relation(fields: [dosen_id], references: [id])

  @@id([application_id, course_id])
}

model Document {
  id          Int                  @id @default(autoincrement())
  title       String               @db.VarChar(255)
  file_url    String               @db.VarChar(255)
  sender_id   Int
  timestamp   DateTime             @default(now()) @db.Timestamp(6)
  sender      User                 @relation(fields: [sender_id], references: [id])
  recipients  Document_Recipient[]
}

model Document_Recipient {
  document_id Int
  user_id     Int
  document    Document @relation(fields: [document_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  @@id([document_id, user_id])
}

model Document_Template {
  id          String  @id @db.VarChar(20)
  title       String  @db.VarChar(255)
  file_url    String  @db.VarChar(255)
  type        String  @db.VarChar(50)
  uploader_id Int?
  uploader    User?   @relation(fields: [uploader_id], references: [id])
}

model Leave_Application {
  id                Int             @id @default(autoincrement())
  mahasiswa_id      Int
  period_id         String          @db.VarChar(20)
  form_url          String          @db.VarChar(255)
  durasi            String          @db.VarChar(50)
  status            String          @db.VarChar(50)
  tanggal_pengajuan DateTime        @default(now()) @db.Timestamp(6)
  alasan_ditolak    String?
  mahasiswa         User            @relation(fields: [mahasiswa_id], references: [id])
  period            Academic_Period @relation(fields: [period_id], references: [id])
}

model TA_Document_Requirement {
  id          Int      @id @default(autoincrement())
  jurusan_id  String   @db.VarChar(10)
  nama        String   @db.VarChar(255)
  deskripsi   String?  @db.Text
  is_active   Boolean  @default(true)
  
  jurusan     Jurusan  @relation(fields: [jurusan_id], references: [id])
  submissions TA_Document_Submission[]
}

model TA_Application {
  id                    Int      @id @default(autoincrement())
  mahasiswa_id          Int
  mahasiswa             User     @relation(fields: [mahasiswa_id], references: [id])
  
  requirements_status   String   @default("belum_upload")
  
  proposal_title        String?  @db.VarChar(255)
  proposal_file_url     String?  @db.VarChar(255)
  proposal_status       String   @default("belum_diajukan")
  approved_by_kaprodi   Boolean  @default(false)
  approved_by_panitia   Boolean  @default(false)

  exam_date             DateTime? @db.Timestamp()
  exam_room             String?   @db.VarChar(50)
  exam_status           String    @default("menunggu_ujian")
  final_score           Float?    
  
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  
  documents             TA_Document_Submission[]
  examiners             TA_Examiner[]
}

model TA_Document_Submission {
  id                Int                     @id @default(autoincrement())
  ta_application_id Int
  requirement_id    Int
  file_url          String                  @db.VarChar(255)
  status            String                  @default("pending")
  feedback          String?                 @db.Text
  
  ta_application    TA_Application          @relation(fields: [ta_application_id], references: [id], onDelete: Cascade)
  requirement       TA_Document_Requirement @relation(fields: [requirement_id], references: [id])

  @@unique([ta_application_id, requirement_id])
}

model TA_Committee {
  id         Int     @id @default(autoincrement())
  jurusan_id String  @db.VarChar(10)
  jurusan    Jurusan @relation(fields: [jurusan_id], references: [id])
  dosen_id   Int
  dosen      User    @relation(fields: [dosen_id], references: [id])
  
  position   String  @db.VarChar(20) 
  is_active  Boolean @default(true)

  @@unique([jurusan_id, position])
}

model TA_Settings {
  id            Int     @id @default(autoincrement())
  jurusan_id    String  @unique @db.VarChar(10)
  jurusan       Jurusan @relation(fields: [jurusan_id], references: [id])
  approval_mode String  @default("kaprodi")
}

model TA_Examiner {
  id                Int            @id @default(autoincrement())
  ta_application_id Int
  ta_application    TA_Application @relation(fields: [ta_application_id], references: [id], onDelete: Cascade)
  dosen_id          Int
  dosen             User           @relation(fields: [dosen_id], references: [id])
  
  peran             String         @default("penguji")

  status_penilaian   String        @default("belum_menilai")
  catatan_revisi     String?       @db.Text
  berita_acara_token String?       @unique @db.VarChar(100)
  waktu_penilaian    DateTime?     @db.Timestamp()
  
  grades             TA_Grade[]

  @@unique([ta_application_id, dosen_id])
}

model TA_Assessment_Component {
  id          Int       @id @default(autoincrement())
  jurusan_id  String    @db.VarChar(10)
  nama        String    @db.VarChar(255)
  bobot       Float     
  is_active   Boolean   @default(true)
  
  jurusan     Jurusan   @relation(fields: [jurusan_id], references: [id])
  grades      TA_Grade[]
}

// 6. Nilai Detail dari masing-masing Dosen Penguji
model TA_Grade {
  id            Int                     @id @default(autoincrement())
  examiner_id   Int
  component_id  Int
  score         Float                   
  
  examiner      TA_Examiner             @relation(fields: [examiner_id], references: [id], onDelete: Cascade)
  component     TA_Assessment_Component @relation(fields: [component_id], references: [id])

  @@unique([examiner_id, component_id])
}

model TA_Supervisor {
  id                 Int          @id @default(autoincrement())
  
  mahasiswa_id       Int          
  mahasiswa          User         @relation("MahasiswaBimbingan", fields: [mahasiswa_id], references: [id], onDelete: Cascade)

  dosen_id           Int
  dosen              User         @relation("DosenPembimbing", fields: [dosen_id], references: [id], onDelete: Cascade)

  status_kajur       String       @default("menunggu_persetujuan")
  
  is_ready_for_exam  Boolean      @default(false) 

  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  logbooks           TA_Logbook[]

  @@unique([mahasiswa_id, dosen_id])
}

model TA_Logbook {
  id                 Int            @id @default(autoincrement())
  
  supervisor_id      Int
  supervisor         TA_Supervisor  @relation(fields: [supervisor_id], references: [id], onDelete: Cascade)

  tanggal            DateTime       @db.Date
  topik              String         @db.Text
  catatan_dosen      String?        @db.Text // Kosong saat mhs baru input, diisi saat dosen review
  
  // Hybrid Collaboration Status
  status             String         @default("menunggu_verifikasi") // 'menunggu_verifikasi', 'terverifikasi'

  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
}

model Laboratorium {
  id             Int      @id @default(autoincrement())
  nama_lab       String   @db.VarChar(255)
  jurusan_id     String   @db.VarChar(10)
  kepala_lab_id  Int?     @unique

  jurusan        Jurusan  @relation(fields: [jurusan_id], references: [id])
  kepala_lab     User?    @relation("KepalaLab", fields: [kepala_lab_id], references: [id])
}